    "test:purchasing": "node scripts/verify-purchasing.mjs",
    "test:supplier-categories": "node scripts/verify-supplier-categories.mjs && node --test --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/supplier-codes.test.mts",
    "test:accounting-hr": "node scripts/verify-accounting-hr.mjs",
    "test:hr-management": "node scripts/verify-hr-management.mjs && node --test --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/hr-validation.test.mts tests/hr-device-ingestion.test.mts",

# Native Windows/PostgreSQL backend (default for offline LAN operation)
SEN_BACKEND=native
NEXT_PUBLIC_SEN_BACKEND=native
DATABASE_URL=postgresql://sen_app:replace_me@127.0.0.1:5432/sen
SESSION_SECRET=replace_with_at_least_48_random_characters_before_startup
SEN_DATA_ROOT=D:\\SEN Data
SEN_PUBLIC_ORIGIN=http://192.168.1.20:3000
SEN_POSTGREST_URL=http://127.0.0.1:3002
SEN_BIND_HOST=0.0.0.0
PORT=3000

# Supabase migration compatibility only. Leave unset for native startup.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional local-only chatbot hashing salt
CHATBOT_HASH_SALT=change-me

# Optional payment providers; leave their gateway disabled until configured
UDDOKTAPAY_BASE_URL=optional
UDDOKTAPAY_API_KEY=optional
UDDOKTAPAY_WEBHOOK_SECRET=optional
EPS_BASE_URL=optional
EPS_API_KEY=optional
EPS_WEBHOOK_SECRET=optional

# Optional test override
CHATBOT_TEST_BASE_URL=http://localhost

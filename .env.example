# Required public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=change-me

# Required server-only configuration
SUPABASE_SERVICE_ROLE_KEY=change-me
CHATBOT_HASH_SALT=change-me

# Optional alternative Supabase server key
SUPABASE_SECRET_KEY=optional

# Optional payment providers; leave their gateway disabled until configured
UDDOKTAPAY_BASE_URL=optional
UDDOKTAPAY_API_KEY=optional
UDDOKTAPAY_WEBHOOK_SECRET=optional
EPS_BASE_URL=optional
EPS_API_KEY=optional
EPS_WEBHOOK_SECRET=optional

# Optional test override
CHATBOT_TEST_BASE_URL=http://localhost

FROM node:22-bookworm AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1 \
    SEN_BACKEND=native \
    NEXT_PUBLIC_SEN_BACKEND=native \
    SEN_RUNTIME_SCOPE=cloud-preview \
    DATABASE_URL=postgresql://preview:preview@127.0.0.1:5432/preview \
    SESSION_SECRET=preview-build-only-secret-value-that-is-never-used-at-runtime \
    SEN_DATA_ROOT=/tmp/sen-data \
    SEN_PUBLIC_ORIGIN=http://127.0.0.1:10000 \
    SEN_POSTGREST_URL=http://127.0.0.1:3002 \
    PORT=10000
RUN npm run build

FROM postgrest/postgrest:v14.15 AS postgrest
FROM node:22-bookworm-slim AS node-runtime
FROM postgres:17-bookworm AS runner
COPY --from=node-runtime /usr/local /usr/local
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=postgrest /bin/postgrest /usr/local/bin/postgrest
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public
COPY --from=builder /app/database ./database
COPY --from=builder /app/scripts/cloud ./scripts/cloud
RUN chmod +x /app/scripts/cloud/start-preview.sh
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    SEN_BACKEND=native \
    NEXT_PUBLIC_SEN_BACKEND=native \
    SEN_RUNTIME_SCOPE=cloud-preview \
    SEN_DATA_ROOT=/tmp/sen-data \
    SEN_POSTGREST_URL=http://127.0.0.1:3002
EXPOSE 10000
CMD ["/app/scripts/cloud/start-preview.sh"]

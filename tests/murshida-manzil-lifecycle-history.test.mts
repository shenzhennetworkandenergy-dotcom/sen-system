import assert from "node:assert/strict";
import { existsSync, readFileSync } from "node:fs";
import test from "node:test";
test("rent recording persists automatic owner allocations before redirecting", () => { const actions = readFileSync("app/admin/murshida-manzil/actions.ts", "utf8"); const allocation = readFileSync("lib/murshida-manzil/rent-allocation.ts", "utf8"); assert.match(actions, /const activeOwners = await listActiveOwners\(\)/); assert.match(actions, /persistRentAndAllocations\(rentPayload, activeOwners/); assert.match(allocation, /validateOwnershipPercentages/); assert.match(allocation, /buildRentAllocationRows/); assert.match(allocation, /insertOwnerAllocations\(allocationRows\)/); assert.match(allocation, /deleteRentTransaction\(transactionId\)/); assert.match(actions, /rentReceipt=\$\{transactionId\}/); });
test("tenant and unit lifecycle actions preserve history by archiving referenced rows", () => { const repository = readFileSync("lib/murshida-manzil/repository.ts", "utf8"); assert.match(repository, /export async function deleteTenant/); assert.match(repository, /export async function deleteUnit/); assert.match(repository, /rent_transactions/); assert.match(repository, /advance_payments/); assert.match(repository, /is_active: false/); });
test("Murshida history routes are database-backed and receipt-linked", () => { for (const route of ["rent", "advance", "expense"]) assert.equal(existsSync(`app/admin/murshida-manzil/history/${route}/page.tsx`), true); assert.match(readFileSync("app/admin/murshida-manzil/history/rent/page.tsx", "utf8"), /rent-receipt/); assert.match(readFileSync("app/admin/murshida-manzil/history/advance/page.tsx", "utf8"), /advance-receipt/); assert.match(readFileSync("app/admin/murshida-manzil/history/expense/page.tsx", "utf8"), /expense-voucher/); });
test("active and archived tenant/unit views are separate and restore is exposed", () => { const panel = readFileSync("app/admin/murshida-manzil/_components/LifecyclePanel.tsx", "utf8"); assert.match(panel, /See All Units/); assert.match(panel, /Archived \/ Inactive Units/); assert.match(panel, /See All Tenants/); assert.match(panel, /Archived \/ Inactive Tenants/); assert.match(panel, /Restore/); assert.match(panel, /setUnitActiveAction/); assert.match(panel, /setTenantActiveAction/); });
